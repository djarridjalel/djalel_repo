# Djarri Design Studio — serving rules.
#
# Compression first: on a cold visit nothing paints until index.html and
# site.css have both arrived, and that pair is ~162KB uncompressed against
# ~46KB gzipped. On mobile data that difference is most of the blank screen.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching. The asset filenames carry no content hash, so nothing here may be
# held long enough to outlive an edit: a stale site.css or content.json would
# be invisible to the person who just published a change. HTML and the
# published content revalidate every time (a 304 costs one small round trip),
# stylesheets and scripts get a day, and the images — which are replaced by
# hand and rarely — get a month.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 day"
  ExpiresByType application/javascript        "access plus 1 day"
  ExpiresByType text/javascript               "access plus 1 day"
  ExpiresByType image/webp                    "access plus 30 days"
  ExpiresByType image/svg+xml                 "access plus 30 days"
  ExpiresByType image/png                     "access plus 30 days"
  ExpiresByType image/jpeg                    "access plus 30 days"
  ExpiresByType model/gltf-binary             "access plus 30 days"
  ExpiresByType font/woff2                    "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # The editor writes this on every publish; it must never be served stale.
  <FilesMatch "content\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# The asset folders are there to be fetched from, not browsed.
Options -Indexes
